# Copy this file to .env and fill in your own values. .env is gitignored.
#   cp .env.example .env

# Free key from https://balldontlie.io
BALLDONTLIE_API_KEY=

# Signs the Flask session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app generates a random key at startup, which means sessions
# do not survive a restart. Never commit a real value.
FLASK_SECRET_KEY=

# Single-user demo login. Multi-user auth is an explicit scope guard.
# Defaults to demo / courtvision when unset.
COURTVISION_USER=
COURTVISION_PASSWORD=
