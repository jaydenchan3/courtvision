__pycache__/
*.py[cod]

# SQLite databases — generated state, regenerated by seed.py
*.db
*.sqlite
*.sqlite3

# Test / tooling output
.pytest_cache/
screenshots/
reports/

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

